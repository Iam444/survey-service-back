{
    "$schema": "https://json.schemastore.org/swcrc",
    "sourceMaps": true,
    "module": {
        "type": "es6"
    },
    "jsc": {
        "target": "es2024",
        "keepClassNames": true,
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "baseUrl": ".",
        "paths": {
            "$components/*": ["src/core/components/*"],
            "$shared/*": ["src/core/shared/*"],
            "$ports/*": ["src/core/ports/*"],
            "$infra/*": ["src/infrastructure/*"]
        }
    }
}
