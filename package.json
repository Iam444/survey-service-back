        "@mikro-orm/postgresql": "^7.2.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "^12.0.1",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "cookie-parser": "^1.4.7",
        "dotenv": "^18.0.8",
        "lang-extensions": "file:./lib/lang-extensions",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "qs": "^6.16.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^10.0.1",
