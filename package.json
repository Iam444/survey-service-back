        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@swc-node/register": "^1.12.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.16.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/node": "^26.4.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/qs": "^6.15.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.0.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
